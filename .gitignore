# Secrets & configuration locale — ne JAMAIS versionner
config.json
config.key
tenants.json
.env
.env.*
!.env.example

# Clés, certificats et coffres de secrets — quel que soit leur dossier.
# Une clé privée versionnée l'est pour toujours (l'historique la garde même
# après suppression) : elle doit être considérée comme compromise.
*.key
*.pem
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.kdbx
*.ppk
*.gpg
*.asc
*.sec
*.secret
*.secrets
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
.htpasswd
.pgpass
.netrc
secrets/
*.larka-publication*

# Bases de données et sauvegardes : données personnelles (noms, courriels),
# empreintes de mots de passe — jamais dans le dépôt, même pour un essai.
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sql
*.sql.gz
*.dump

# Données d'exécution — ne pas packager ni versionner
data/sessions/*
data/logs/*
data/rate_limits/*
data/run/*
data/backups/*
data/oauth_states/*
data/oauth_result_*.json
data/sa_oauth_result_*.json
data/maj/
data/.schema/
data/superadmin_tenants_cache.json
data/cache*/
data/plans/
data/fonds/
data/thematiques/
data/rgpd/

# Journaux de sécurité (IP, logins, tentatives échouées) et médias des
# procédures d'urgence : contenu du tenant, à ne JAMAIS publier.
data/security/*
data/urgences/*
data/.license_accepted

# Placeholders et garde-fous serveur, eux, sont versionnés
!data/**/.gitkeep
!data/security/.htaccess

# Divers
*.log
*.bak
*.orig

# Extensions installées : relèvent de l'exploitation, pas du dépôt de code.
# (Le code déplié, les paquets reçus et le stockage privé vivent ici.)
data/extensions/

# Bases jetables du banc d'essai du SDK
.banc/

# Paquets de publication (outils/publier-version.php) : joints aux releases, pas au dépôt
dist/

# Windows : PHP installé par Larka.cmd (et ses états transitoires de mise à
# jour), comptes et guide copiés par « Larka.cmd demo ».
php/
php.nouveau/
php.ancien/
data/demo/
data/tmp-demo-*/

# Démonstration « Ville de Larkaville » : celle du dépôt vit dans demo/
# (données fictives). Une autre copie posée dans le dossier (archive ou
# dossier décompressé) n'est pas versionnée.
*demo-Larkaville*.zip
*demo-Larkaville*/
!demo/sauvegarde-demo-Larkaville.zip
