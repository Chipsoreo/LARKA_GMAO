  "donnees": {
    "prestataires": {
      "libelle": "Prestataire",
      "libelle_pluriel": "Prestataires",
      "champs": {
        "raison_sociale": {
          "type": "texte",
          "libelle": "Raison sociale",
          "obligatoire": true,
          "unique": true,
          "max": 120,
          "groupe": "Coordonnées",
          "suggestions": true,
          "suggestions_source": "fournisseurs",
          "largeur": "grand"
        },
        "domaine": {
          "type": "choix",
          "libelle": "Domaine",
          "liste": "PrestataireDomaine",
          "groupe": "Coordonnées",
          "ajout_autorise": true,
          "valeurs_initiales": [
            "Électricité",
            "Plomberie",
            "CVC",
            "Espaces verts",
            "Nettoyage",
            "Levage",
            "Incendie",
            "Serrurerie"
          ],
          "largeur": "moyen"
        },
        "telephone": {
          "type": "texte",
          "libelle": "Téléphone",
          "format_saisie": "telephone",
          "groupe": "Coordonnées",
          "largeur": "moyen"
        },
        "courriel": {
          "type": "texte",
          "libelle": "Courriel",
          "format_saisie": "email",
          "groupe": "Coordonnées",
          "largeur": "grand"
        },
        "site": {
          "type": "texte",
          "libelle": "Site web",
          "format_saisie": "url",
          "groupe": "Coordonnées",
          "masque_liste": true,
          "largeur": "grand"
        },
        "interventions": {
          "type": "choix_multiple",
          "libelle": "Interventions assurées",
          "groupe": "Coordonnées",
          "valeurs": [
            "Préventif",
            "Curatif",
            "Contrôle réglementaire",
            "Dépannage d'urgence",
            "Travaux neufs"
          ],
          "masque_liste": true,
          "largeur": "grand"
        },
        "astreinte": {
          "type": "booleen",
          "libelle": "Astreinte 24 h / 24",
          "groupe": "Coordonnées",
          "defaut": false,
          "largeur": "petit"
        },
        "siret": {
          "type": "texte",
          "libelle": "SIRET",
          "format_saisie": "siret",
          "groupe": "Administratif",
          "masque_liste": true,
          "largeur": "moyen"
        },
        "assurance": {
          "type": "date",
          "libelle": "Assurance jusqu'au",
          "groupe": "Administratif",
          "largeur": "moyen"
        },
        "contrat": {
          "type": "lien",
          "vers": "contrats",
          "libelle": "Contrat en cours",
          "groupe": "Administratif",
          "masque_liste": true
        },
        "statut": {
          "type": "choix",
          "libelle": "Statut",
          "groupe": "Appréciation",
          "valeurs": [
            "Référencé",
            "En évaluation",
            "Écarté"
          ],
          "defaut": "En évaluation",
          "couleurs": {
            "Référencé": "vert",
            "En évaluation": "orange",
            "Écarté": "rouge"
          },
          "largeur": "moyen"
        },
        "note": {
          "type": "note",
          "libelle": "Évaluation",
          "groupe": "Appréciation",
          "largeur": "petit"
        },
        "motif_ecart": {
          "type": "texte_long",
          "libelle": "Motif de l'écart",
          "max": 800,
          "groupe": "Appréciation",
          "masque_liste": true,
          "visible_si": {
            "champ": "statut",
            "operateur": "egal",
            "valeur": "Écarté"
          },
          "largeur": "pleine"
        },
        "remarques": {
          "type": "texte_long",
          "libelle": "Remarques",
          "max": 800,
          "groupe": "Appréciation",
          "masque_liste": true,
          "largeur": "pleine"
        },
        "assurance_etat": {
          "type": "formule",
          "libelle": "Assurance",
          "expression": "{{if(isEmpty(record.assurance), 'Non renseignée', if(isPast(record.assurance), 'Expirée', concat('Valide — ', diffDays(record.assurance, today), ' j')))}}"
        },
        "appreciation": {
          "type": "formule",
          "libelle": "Appréciation chiffrée",
          "expression": "{{if(isEmpty(record.note), 'Non évalué', if(record.note < reglages.note_minimale, 'Sous le seuil', 'Satisfaisant'))}}"
        }
      }
    },
    "habilitations": {
      "libelle": "Habilitation",
      "libelle_pluriel": "Habilitations",
      "champs": {
        "titulaire": {
          "type": "texte",
          "libelle": "Titulaire",
          "obligatoire": true,
          "max": 80,
          "groupe": "Identification",
          "suggestions": true,
          "suggestions_source": "personnes"
        },
        "employeur": {
          "type": "texte",
          "libelle": "Employeur",
          "max": 120,
          "groupe": "Identification",
          "exemple": "Régie, ou le nom du prestataire",
          "suggestions": true,
          "suggestions_source": "fournisseurs"
        },
        "intitule": {
          "type": "texte",
          "libelle": "Intitulé",
          "obligatoire": true,
          "max": 120,
          "groupe": "Identification"
        },
        "categorie": {
          "type": "choix",
          "libelle": "Catégorie",
          "liste": "HabilitationCategorie",
          "groupe": "Identification",
          "libre": false,
          "ajout_autorise": true,
          "aide": "Modifiable dans Configuration → Listes ; une valeur peut être ajoutée à la saisie",
          "valeurs_initiales": [
            "Électrique",
            "Levage",
            "Travail en hauteur",
            "Incendie",
            "Premiers secours",
            "Conduite d'engin",
            "Fluides frigorigènes"
          ]
        },
        "indices": {
          "type": "choix_multiple",
          "libelle": "Indices",
          "groupe": "Identification",
          "valeurs": [
            "B0",
            "B0V",
            "H0",
            "H0V",
            "B1",
            "B1V",
            "B2",
            "B2V",
            "BR",
            "BC",
            "BE Essai",
            "BE Mesurage",
            "BE Vérification",
            "H1",
            "H1V",
            "H2",
            "H2V",
            "HC",
            "HE"
          ],
          "aide": "Habilitations électriques : les indices portés sur le titre (NF C 18-510)",
          "visible_si": {
            "champ": "categorie",
            "operateur": "egal",
            "valeur": "Électrique"
          },
          "masque_liste": true
        },
        "organisme": {
          "type": "texte",
          "libelle": "Organisme",
          "max": 80,
          "exemple": "Apave, Socotec…",
          "groupe": "Validité",
          "suggestions": true,
          "suggestions_source": "fournisseurs"
        },
        "courriel": {
          "type": "texte",
          "libelle": "Contact organisme",
          "format_saisie": "email",
          "groupe": "Validité"
        },
        "obtenue_le": {
          "type": "date",
          "libelle": "Obtenue le",
          "obligatoire": true,
          "max_date": "today",
          "defaut": "{{today}}",
          "groupe": "Validité"
        },
        "validite": {
          "type": "entier",
          "libelle": "Validité",
          "unite": "mois",
          "min": 1,
          "max": 240,
          "defaut": 36,
          "groupe": "Validité"
        },
        "cout": {
          "type": "decimal",
          "libelle": "Coût de la formation",
          "min": 0,
          "unite": "€",
          "groupe": "Validité",
          "masque_liste": true
        },
        "equipement": {
          "type": "lien",
          "vers": "equipements",
          "libelle": "Équipement concerné",
          "groupe": "Portée"
        },
        "bien": {
          "type": "lien",
          "vers": "biens",
          "libelle": "Matériel concerné",
          "groupe": "Portée",
          "aide": "Un bien de l'inventaire dont l'usage exige l'habilitation : échafaudage, nacelle, autoportée…"
        },
        "expire_le": {
          "type": "formule",
          "libelle": "Valable jusqu'au",
          "format": "date",
          "expression": "{{addMonths(record.obtenue_le, record.validite)}}"
        },
        "jours_restants": {
          "type": "formule",
          "libelle": "Jours restants",
          "format": "nombre",
          "expression": "{{diffDays(addMonths(record.obtenue_le, record.validite), today)}}"
        },
        "situation": {
          "type": "formule",
          "libelle": "Situation",
          "expression": "{{if(diffDays(addMonths(record.obtenue_le, record.validite), today) < 0, 'Expirée', if(diffDays(addMonths(record.obtenue_le, record.validite), today) <= reglages.prealerte_jours, 'À renouveler', 'Valide'))}}"
        }
      }
    }
  },
