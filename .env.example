# ═══════════════════════════════════════════════════════════════════════════════
# Larka — Secrets (modèle)
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copier en .env À CÔTÉ de config.json, puis renseigner ce qui vous concerne.
#
#   cp .env.example .env
#   chmod 600 .env && chown www-data:www-data .env
#
# RÈGLES
#   • Ce fichier contient les SECRETS ; config.json n'en contient aucun.
#   • Une variable définie ici ÉCRASE la valeur correspondante de config.json.
#   • Ne jamais versionner .env (déjà exclu par .gitignore).
#   • Laisser une ligne vide ou absente = la valeur de config.json s'applique.
#   • Pas de guillemets nécessaires ; pas d'espace autour du « = ».
#
# Correspondance .env → config.json : voir api/EnvFile.php
# ═══════════════════════════════════════════════════════════════════════════════


# ── Base de données ──────────────────────────────────────────────────────────
# → base_de_donnees.password
GMAO_DB_PASSWORD=

# Base du registre multi-tenant → superadmin_db.password
GMAO_SUPERADMIN_DB_PASSWORD=


# ── Clé secrète de l'application ─────────────────────────────────────────────
# → securite.secret_key
# Sert à signer le relais OAuth. Doit faire au moins 16 caractères, sinon le
# relais est désactivé (repli sur la redirection locale directe).
# Générer :  openssl rand -hex 32
GMAO_SECRET_KEY=


# ── Microsoft OAuth (Azure) ──────────────────────────────────────────────────
# → microsoft_oauth.*
# Azure Portal > App registrations > votre app.
# L'URI de redirection doit correspondre EXACTEMENT à celle déclarée dans Azure.
GMAO_MICROSOFT_CLIENT_SECRET=
GMAO_MICROSOFT_CLIENT_ID=
GMAO_MICROSOFT_TENANT_ID=
GMAO_MICROSOFT_REDIRECT_URI=
GMAO_MICROSOFT_REDIRECT_URI_MOBILE=


# ── Google OAuth ─────────────────────────────────────────────────────────────
# → google_oauth.*
GMAO_GOOGLE_CLIENT_SECRET=
GMAO_GOOGLE_CLIENT_ID=
GMAO_GOOGLE_REDIRECT_URI=
GMAO_GOOGLE_REDIRECT_URI_MOBILE=


# ── SMTP (emails : réinitialisation de mot de passe, retours) ────────────────
# → smtp.password
# L'envoi d'emails s'active en renseignant smtp.host dans config.json.
GMAO_SMTP_PASSWORD=


# ── Notifications push (VAPID) ───────────────────────────────────────────────
# → push.vapid_private_pem
# Le plus simple : générer la paire depuis l'interface (Configuration →
# Notifications), qui renseigne la clé publique dans config.json.
# En CLI :  openssl ecparam -name prime256v1 -genkey -noout -out vapid.pem
# Coller ici le PEM sur UNE seule ligne, sauts de ligne remplacés par \n.
GMAO_VAPID_PRIVATE_KEY=


# ── Assistant IA ─────────────────────────────────────────────────────────────
# → assistant.api_key
# Inutile pour un modèle local (ollama, lmstudio, vllm).
GMAO_ASSISTANT_API_KEY=


# ── Légifrance (PISTE / DILA) ────────────────────────────────────────────────
# → legifrance.client_secret
GMAO_LEGIFRANCE_CLIENT_SECRET=

# ── Mises à jour ─────────────────────────────────────────────────────────────
# → mises_a_jour (source github). Seulement si le dépôt des versions est PRIVÉ :
# jeton GitHub en lecture seule (Contents: read) sur ce dépôt.
GMAO_MAJ_GITHUB_TOKEN=
